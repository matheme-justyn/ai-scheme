#!/usr/bin/env bash
# Repository settings, declared in policies/ and compared against reality.
#
#   scripts/apply-repository-settings plan          what differs
#   scripts/apply-repository-settings check         exit 1 if anything differs
#   scripts/apply-repository-settings apply --area repository
#
# `plan` and `check` are read-only. `apply` writes, and it refuses the two
# areas a person should set themselves: branch rulesets and security switches.
set -euo pipefail
# shellcheck source=scripts/_runner.sh
. "$(dirname "$0")/_runner.sh"
ai_scheme_run settings "$@"
