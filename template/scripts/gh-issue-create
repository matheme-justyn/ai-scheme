#!/usr/bin/env bash
# `gh issue create` with the title checked first, and a nudge about the open
# milestone. Everything after the title is passed through untouched.
#
#   scripts/gh-issue-create "Add a deterministic status command" --label type:task
#
# The milestone hint is a hint: it prints, it does not block and it does not
# add the milestone for you. Leaf issues carry the milestone, Feature parents
# do not -- see docs/milestone-description.md.
set -euo pipefail
# shellcheck source=scripts/_runner.sh
. "$(dirname "$0")/_runner.sh"

if [ "$#" -lt 1 ]; then
  echo "usage: $(basename "$0") <title> [gh issue create options...]" >&2
  exit 2
fi

title="$1"
shift

ai_scheme_run issue validate-title "$title"

if milestone="$("$(dirname "$0")/detect-open-milestone" 2>/dev/null)"; then
  echo "note: one open milestone -- ${milestone}" >&2
  echo "      add --milestone \"${milestone}\" if this issue is a leaf of it" >&2
fi

exec gh issue create --title "$title" "$@"
