#!/usr/bin/env bash
# Secrets, in the working tree and in reachable history.
#
# History matters: a secret removed in a later commit is still published, and
# rewriting history is the expensive way to find that out.
set -euo pipefail
# shellcheck source=scripts/_runner.sh
. "$(dirname "$0")/_runner.sh"
ai_scheme_run secrets scan "$@"
