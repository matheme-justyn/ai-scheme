#!/usr/bin/env bash
# Run the verification tier that matches what is being pushed.
#
# This replaces the old "every push to main must bump the version" hook: the
# version is decided by the release flow from the pull request's intent, not by
# a hook, and a hook that blocks a push for the wrong reason gets bypassed and
# then ignored.
#
# Install: git config core.hooksPath hooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if [ ! -x "${repo_root}/scripts/verify" ]; then
  exit 0
fi

echo "pre-push: running scripts/verify"
"${repo_root}/scripts/verify"
